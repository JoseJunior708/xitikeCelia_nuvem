<!DOCTYPE html>
<html lang="pt" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config = { darkMode: 'media' }</script>
  <title>Bloqueados</title>
</head>
<body class="bg-zinc-50 dark:bg-black text-zinc-900 dark:text-zinc-100 min-h-screen transition-colors duration-500 overflow-x-hidden">

  <main class="max-w-5xl mx-auto p-6 md:py-12">
    <header class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black">Sinalizados</h1>
        <p class="text-zinc-500 text-sm">Reciclaram um comprovativo, mas já tinham recebido, não serão removidos automaticamente.</p>
      </div>
      <div class="flex items-center gap-2">
        <a href="/admin" class="px-4 py-2 rounded-lg bg-zinc-900 border border-zinc-800 text-xs font-bold uppercase tracking-wider text-zinc-300 hover:bg-zinc-800 transition-colors">← Início</a>
        <a href="/admin/pagamentos" class="px-4 py-2 rounded-lg bg-zinc-900 border border-zinc-800 text-xs font-bold uppercase tracking-wider text-zinc-300 hover:bg-zinc-800 transition-colors">Pagamentos →</a>
      </div>
    </header>

    <% if (bloqueados.length === 0) { %>
      <p class="text-zinc-500">Ninguém sinalizado até agora.</p>
    <% } %>

    <div class="space-y-3">
      <% bloqueados.forEach(b => { %>
        <div class="p-5 border-2 border-red-500 rounded-2xl bg-white dark:bg-zinc-900">
          <div class="flex items-center justify-between mb-1">
            <span class="font-black"><%= b.nome %></span>
            <span class="text-xs text-zinc-500"><%= b.nome_grupo %></span>
          </div>
          <p class="text-sm text-zinc-500"><%= b.motivo %></p>
          <div class="flex items-center justify-between mt-3">
            <p class="text-[10px] text-zinc-600 uppercase font-bold tracking-wider">Sinalizado em <%= b.criado_em %></p>
            <form method="POST" action="/admin/bloqueados/desbloquear">
              <input type="hidden" name="id_whatsapp" value="<%= b.id_whatsapp %>">
              <input type="hidden" name="id_grupo" value="<%= b.id_grupo %>">
              <button type="submit" class="text-xs font-bold uppercase tracking-wider bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-full">Desbloquear</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </main>
</body>
</html>
