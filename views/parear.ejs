<!DOCTYPE html>
<html lang="pt" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config = { darkMode: 'media' }</script>
  <title>Ligar WhatsApp</title>
</head>
<body class="bg-zinc-50 dark:bg-black text-zinc-900 dark:text-zinc-100 min-h-screen transition-colors duration-500 overflow-x-hidden">

  <main class="max-w-lg mx-auto p-6 md:py-12">
    <header class="mb-8 flex items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black">Ligar WhatsApp</h1>
        <p class="text-zinc-500 text-sm">Usa o QR — não expira em 1 minuto como o código.</p>
      </div>
      <a href="/admin" class="px-4 py-2 rounded-lg bg-zinc-900 border border-zinc-800 text-xs font-bold uppercase tracking-wider text-zinc-300 hover:bg-zinc-800 transition-colors">← Início</a>
    </header>

    <p class="-mt-4 mb-6"><a href="/admin/sessao" class="text-xs font-bold uppercase tracking-wider text-amber-500 underline">Já tens a sessão emparelhada noutro sítio? Carrega aqui em vez de parear</a></p>

    <% if (estado.ligado) { %>
      <div class="p-6 border-2 border-green-500 rounded-2xl bg-white dark:bg-zinc-900">
        <p class="text-lg font-black text-green-500">Bot ligado. Não precisas de fazer nada aqui.</p>
      </div>
    <% } else { %>

      <div class="p-6 border-2 border-zinc-800 rounded-2xl bg-white dark:bg-zinc-900 text-center">
        <% if (qrDisponivel) { %>
          <img src="<%= qr %>" alt="QR de pareamento" class="mx-auto w-64 h-64 rounded-xl bg-white" />
          <p class="mt-4 text-sm text-zinc-400">No telemóvel: WhatsApp → Aparelhos ligados → Ligar aparelho → <strong>Digitalizar QR</strong>.</p>
          <p class="mt-2 text-xs text-zinc-500">Se a página não atualizar sozinha, recarrega daqui a 20 segundos.</p>
          <meta http-equiv="refresh" content="20" />
        <% } else { %>
          <p class="text-lg font-black text-amber-500">Ainda não há QR. Aguarda 20 segundos e recarrega.</p>
          <meta http-equiv="refresh" content="15" />
        <% } %>
      </div>

      <div class="mt-6 p-6 border-2 border-zinc-800 rounded-2xl bg-white dark:bg-zinc-900">
        <p class="text-sm text-zinc-400">Alternativa: código de 8 dígitos (expira em ~1 minuto).</p>
        <% if (codigo) { %>
          <p class="mt-3 text-4xl font-black tracking-[0.3em] text-center select-all"><%= codigo %></p>
        <% } else { %>
          <p class="mt-3 text-zinc-500 text-sm">Sem código disponível.</p>
        <% } %>
        <form method="POST" action="/admin/parear/codigo" class="mt-4">
          <button type="submit" class="w-full px-4 py-2.5 rounded-lg bg-zinc-900 border border-zinc-800 text-xs font-bold uppercase tracking-wider text-zinc-300 hover:bg-zinc-800 transition-colors">Gerar novo código</button>
        </form>
      </div>
    <% } %>

    <p class="mt-6 text-xs text-zinc-500 text-center">O QR é gerado pelo WhatsApp, não pela Xitike. Não partilhe esta página com ninguém.</p>
  </main>

</body>
</html>
